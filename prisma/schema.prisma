generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // Sin motor nativo (binario de Rust): las consultas van por el driver `pg` (src/lib/db.ts).
  // Así no hay que empaquetar ningún .so.node en las funciones de Vercel.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooler) para las migraciones; en local es la misma URL.
  // El nombre es el que pone la integración de Neon en Vercel.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Acceso ----------

// Anfitrión (id "host", entra con la contraseña y el código TOTP de las variables de entorno)
// o miembro (registrado con una invitación, entra con usuario y contraseña).
model User {
  id                 String    @id @default(cuid())
  // "host" | "member"
  role               String    @default("member")
  username           String    @unique
  // scrypt; null en el anfitrión (su contraseña vive en HOST_PASSWORD_HASH) y en las cuentas solo de Google.
  passwordHash       String?
  // Permiso para el modo Spotify: solo con invitación (las cuentas gratis de Google empiezan sin él).
  spotifyAllowed     Boolean   @default(false)
  // El anfitrión le restableció la contraseña: al entrar se le pide que ponga una suya.
  mustChangePassword Boolean   @default(false)
  displayName        String
  disabledAt         DateTime?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())

  spotify  SpotifyAccount?
  google   GoogleAccount?
  sessions Session[]
  games    Game[]
  invites  Invite[]
  joined   Participant[]
}

// Cuenta de Spotify vinculada a un usuario. Los tokens van cifrados (AES-256-GCM).
model SpotifyAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  spotifyUserId String   @unique
  displayName   String?
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Cuenta de Google con la que se entra (OpenID Connect). Solo guardamos su identidad, nunca sus tokens.
model GoogleAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  // "sub" del id_token: el identificador estable de la cuenta de Google.
  googleSub String   @unique
  email     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sesión iniciada. El id es el SHA-256 del token de la cookie (el token nunca se guarda).
model Session {
  id         String   @id
  userId     String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Código de invitación de un solo uso (se guarda su SHA-256).
model Invite {
  id           String    @id @default(cuid())
  codeHash     String    @unique
  note         String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?

  usedBy User? @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)
}

// Visitante sin cuenta. El id es el SHA-256 del token de su cookie.
model Guest {
  id         String    @id
  ipHash     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  blockedAt  DateTime?

  games Game[]

  @@index([ipHash, createdAt])
  @@index([lastSeenAt])
}

// IP (como hash) a la que el anfitrión le cerró el modo invitado.
model BlockedIp {
  ipHash    String   @id
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// Estado global (una sola fila, id "app").
model AppState {
  id                 String  @id @default("app")
  // Último paso TOTP aceptado: un mismo código no sirve dos veces.
  lastTotpCounter    Int?
  openModePaused     Boolean @default(false)
  guestSignupsPaused Boolean @default(false)
}

model Game {
  id               String   @id @default(cuid())
  // Dueño: un usuario o un invitado (exactamente uno de los dos).
  userId           String?
  guestId          String?
  // Código corto para que en el futuro los jugadores se unan desde el móvil.
  code             String   @unique
  // "spotify" (canción completa con el SDK) | "open" (vista previa de 30 s de iTunes, sin cuenta)
  mode             String   @default("spotify")
  // LOBBY | PLAYING | FINISHED
  status           String   @default("LOBBY")
  totalRounds      Int
  currentRound     Int      @default(0)
  fragmentSeconds  Int
  // "solo" (todos contra todos) | "teams" (cada Player es un equipo con sus miembros)
  format           String   @default("solo")
  // Máximo de miembros por equipo (solo en partidas por equipos).
  maxTeamSize      Int?
  // Segundos que tiene quien pulsa «¡Lo sé!» para escribir su respuesta.
  answerSeconds    Int      @default(20)
  // Al fallar queda fuera: "person" (solo quien falló) | "team" (todo su equipo).
  lockout          String   @default("person")
  // El anfitrión puede cerrar la entrada de más gente.
  joinOpen         Boolean  @default(true)
  // GameFilters serializado como JSON.
  filters          String
  // Siguiente canción ya elegida en segundo plano (JSON de PickedTrack) y filtros con que se eligió.
  nextTrack        String?
  nextTrackFilters String?
  // Partida creada con «Otra igual» desde esta (cuando termina): los móviles unidos la siguen solos.
  nextGameId       String?
  // Código secreto del enlace público del resultado (/r/<código>); solo existe tras pulsar «Compartir».
  // Quitarlo («Dejar de compartir») mata el enlace y la imagen.
  shareToken       String?  @unique
  // Idioma de quien compartió: la tarjeta y su vista previa salen en él.
  shareLocale      String?
  createdAt        DateTime @default(now())

  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest         Guest?        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  players       Player[]
  rounds        Round[]
  participants  Participant[]
  // Si se borra la nueva (p. ej. al editar sus ajustes antes de empezar), el enlace se suelta solo.
  nextGame      Game?         @relation("Replay", fields: [nextGameId], references: [id], onDelete: SetNull)
  previousGames Game[]        @relation("Replay")

  @@index([userId, createdAt])
  @@index([guestId, createdAt])
}

model Player {
  id     String  @id @default(cuid())
  gameId String
  name   String
  score  Int     @default(0)
  // Color del equipo (clave de la paleta de teams.ts); null en partidas de todos contra todos.
  color  String?

  game       Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  guesses    Guess[]
  wins       Round[]       @relation("RoundWinner")
  artistWins Round[]       @relation("RoundArtistWinner")
  members    TeamMember[]
  seated     Participant[]

  @@unique([gameId, name])
}

// Una persona dentro de un equipo. Más adelante el móvil le añadirá quién es (invitado o cuenta).
model TeamMember {
  id        String   @id @default(cuid())
  playerId  String
  name      String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model Round {
  id                   String    @id @default(cuid())
  gameId               String
  number               Int
  trackId              String
  trackUri             String
  trackName            String
  artists              String
  // JSON con los ids de Spotify de los artistas.
  artistIds            String    @default("[]")
  // Género para la pista (puede faltar si Spotify no lo da).
  genre                String?
  albumImage           String?
  // URL de la vista previa (solo modo abierto).
  audioUrl             String?
  // De qué búsqueda salió la canción (p. ej. `genre:"salsa" year:1980-1989 @20`), para revisar elecciones raras.
  pickedVia            String?
  durationMs           Int
  startMs              Int
  // PLAYING | WON | REVEALED
  status               String    @default("PLAYING")
  winnerPlayerId       String?
  // Quien se llevó el punto de artista (solo uno por ronda).
  artistWinnerPlayerId String?
  // Primera vez que sonó el fragmento: marca el reloj de puntos y pistas.
  playStartedAt        DateTime?
  // Pausa del anfitrión: congela el reloj de puntos y pistas.
  pausedAt             DateTime?
  pausedMs             Int       @default(0)
  // Quién tiene el turno tras pulsar «¡Lo sé!», desde cuándo y hasta cuándo puede responder.
  buzzParticipantId    String?
  buzzedAt             DateTime?
  buzzDeadline         DateTime?
  createdAt            DateTime  @default(now())

  game         Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  winner       Player?        @relation("RoundWinner", fields: [winnerPlayerId], references: [id])
  artistWinner Player?        @relation("RoundArtistWinner", fields: [artistWinnerPlayerId], references: [id])
  guesses      Guess[]
  lockouts     RoundLockout[]

  @@unique([gameId, number])
}

model Guess {
  id            String   @id @default(cuid())
  roundId       String
  playerId      String
  titleText     String?
  artistText    String?
  titleCorrect  Boolean  @default(false)
  artistCorrect Boolean  @default(false)
  // Puntos que dio este intento (tramo de velocidad + artista).
  points        Int      @default(0)
  // El anfitrión lo dio por bueno manualmente.
  overridden    Boolean  @default(false)
  // Quién respondió desde su móvil (null si lo registró el anfitrión).
  participantId String?
  createdAt     DateTime @default(now())

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// Una persona que se unió a la partida desde su móvil o PC con el código. Su cookie guarda el token.
model Participant {
  id        String    @id @default(cuid())
  gameId    String
  // Su jugador (todos contra todos) o su equipo.
  playerId  String
  // Su sitio dentro del equipo (solo en partidas por equipos).
  memberId  String?
  // Cuenta de la app, si entró con sesión iniciada.
  userId    String?
  name      String
  tokenHash String    @unique
  // Otro navegador pide quedarse con este sitio (perdió su sesión): SHA-256 de su token y cuándo lo pidió.
  // Solo vale si el anfitrión lo acepta (entonces pasa a ser el `tokenHash`); caduca a los 5 minutos.
  claimHash String?
  claimAt   DateTime?
  // El propio anfitrión juega desde su pantalla con este nombre: no se le puede sacar de la partida.
  isHost    Boolean   @default(false)
  kickedAt  DateTime?
  createdAt DateTime  @default(now())

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@index([gameId, userId])
}

// Quién ya no puede pulsar en una ronda: una persona o, con lockout "team", todo su equipo.
model RoundLockout {
  id            String  @id @default(cuid())
  roundId       String
  participantId String?
  playerId      String?

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId])
  @@unique([roundId, playerId])
}

// Caché de búsquedas en iTunes (modo abierto): por término y tienda, los resultados ya normalizados a Track.
// Protege el límite de iTunes (todas las visitas salen por las IP de Vercel) y, si iTunes falla, se juega
// con lo último guardado. La limpieza diaria borra lo de más de 30 días.
model ItunesSearch {
  // En minúsculas y con los espacios normalizados.
  term      String
  country   String
  // Track[] (JSON).
  tracks    Json
  fetchedAt DateTime @default(now())

  @@id([term, country])
  @@index([fetchedAt])
}

// Cada «Probar filtros» del modo abierto (invitados y cuentas sin invitación): cuenta para su tope por hora,
// porque cada prueba puede llamar a iTunes. La limpieza diaria borra las de más de un día.
model FilterTest {
  id        String   @id @default(cuid())
  // "guest:<id>" o "user:<id>".
  ownerKey  String
  createdAt DateTime @default(now())

  @@index([ownerKey, createdAt])
  @@index([createdAt])
}

// Analítica propia, sin datos personales: qué pasos da la gente (sin nombres, IP ni cuentas).
// Sin clave foránea a Game: los eventos sobreviven cuando se borra una partida o la limpieza se lleva a un invitado.
model GameEvent {
  id        String   @id @default(cuid())
  // guest_started | game_created | game_started | game_finished | phone_joined | phone_followed | result_shared | seat_reclaimed
  type      String
  // Id de la partida (aleatorio, no identifica a nadie) para enlazar creada → empezada → terminada.
  gameId    String?
  // "open" | "spotify"
  mode      String?
  // "solo" | "teams"
  format    String?
  // Quién la grabó: "guest" | "free" | "member" | "host" (el tipo, nunca el id).
  ownerKind String?
  // Partida creada con «Otra igual».
  replay    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}
