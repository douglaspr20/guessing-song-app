# Copia este archivo a `.env` (Prisma solo lee `.env`; Next lee `.env` y `.env.local`).
# Base de datos: Postgres local con `docker compose up -d` (ver docker-compose.yml).
# En producción la integración de Neon en Vercel crea las dos: DATABASE_URL (con pooler, la usa la app)
# y DATABASE_URL_UNPOOLED (directa, la usan las migraciones).
DATABASE_URL="postgresql://adivina:adivina@localhost:5432/adivina"
DATABASE_URL_UNPOOLED="postgresql://adivina:adivina@localhost:5432/adivina"

# Rellena estos con los valores de tu app de Spotify
# (https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la Redirect URI registrada en Spotify.
# Spotify no acepta "localhost": usa 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Entrar con Google (opcional: sin estas tres variables no aparece el botón).
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# Registra como URI de redirección autorizada la misma que pongas aquí.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# Secretos del servidor (acceso del anfitrión, cifrado de tokens y limpieza diaria).
# Nunca en el repo.
HOST_PASSWORD_HASH=
HOST_TOTP_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
