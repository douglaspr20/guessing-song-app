{
  "name": "adivina-la-cancion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "next build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "ably": "2.29.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
